## Allows the group abls to execute these commands
%abls  ALL=(ALL) NOPASSWD: /usr/bin/apt update -y
%abls  ALL=(ALL) NOPASSWD: /usr/bin/apt upgrade -y
%abls  ALL=(ALL) NOPASSWD: /usr/sbin/dnf upgrade -y
%abls  ALL=(ALL) NOPASSWD: /usr/sbin/poweroff
%abls  ALL=(ALL) NOPASSWD: /usr/sbin/reboot
## Command for Agents
%abls ALL=(ALL) NOPASSWD: /usr/bin/apt install -y abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/apt upgrade -y abls-*
%abls ALL=(ALL) NOPASSWD: /usr/sbin/dnf install -y abls-*
%abls ALL=(ALL) NOPASSWD: /usr/sbin/dnf upgrade -y abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl start abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl disable abls-*

%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user stop abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user start abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user restart abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user enable abls-*
%abls ALL=(ALL) NOPASSWD: /usr/bin/systemctl --user disable abls-*

Defaults:%abls !requiretty